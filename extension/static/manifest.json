{
  "manifest_version": 3,
  "name": "Influencer Butler",
  "version": "0.1.1",
  "description": "Free tools for Amazon Influencers: video counts, content gaps in your orders, Butler Approved seals, and storefront checks.",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.co.uk/*",
    "https://affiliate-program.amazon.com/*",
    "https://affiliate-program.amazon.ca/*",
    "https://affiliate-program.amazon.co.uk/*",
    "https://www.influencerbutler.com/*",
    "https://links.influencerbutler.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.openai.com/*",
    "https://webservices.amazon.com/*",
    "https://webservices.amazon.ca/*",
    "https://webservices.amazon.com.mx/*",
    "https://webservices.amazon.com.br/*",
    "https://webservices.amazon.co.uk/*",
    "https://webservices.amazon.de/*",
    "https://webservices.amazon.fr/*",
    "https://webservices.amazon.it/*",
    "https://webservices.amazon.es/*",
    "https://webservices.amazon.nl/*",
    "https://webservices.amazon.se/*",
    "https://webservices.amazon.pl/*",
    "https://webservices.amazon.com.tr/*",
    "https://webservices.amazon.ae/*",
    "https://webservices.amazon.sa/*",
    "https://webservices.amazon.in/*",
    "https://webservices.amazon.co.jp/*",
    "https://webservices.amazon.com.au/*",
    "https://webservices.amazon.sg/*",
    "https://api.urlgeni.us/*",
    "https://api.geni.us/*",
    "https://linktw.in/*",
    "https://app.levanta.io/*",
    "https://api.archeraffiliates.com/*",
    "https://api.logie.ai/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/dp/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/gp/product/*",
        "https://www.amazon.com/gp/css/order-history*",
        "https://www.amazon.com/your-orders/*",
        "https://www.amazon.com/shop/*",
        "https://www.amazon.com/creatorhub/*",
        "https://affiliate-program.amazon.com/p/connect/*",
        "https://www.amazon.com/s*",
        "https://www.amazon.ca/dp/*",
        "https://www.amazon.ca/*/dp/*",
        "https://www.amazon.ca/gp/product/*",
        "https://www.amazon.ca/gp/css/order-history*",
        "https://www.amazon.ca/your-orders/*",
        "https://www.amazon.ca/shop/*",
        "https://www.amazon.ca/creatorhub/*",
        "https://affiliate-program.amazon.ca/p/connect/*",
        "https://www.amazon.ca/s*",
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.co.uk/*/dp/*",
        "https://www.amazon.co.uk/gp/product/*",
        "https://www.amazon.co.uk/gp/css/order-history*",
        "https://www.amazon.co.uk/your-orders/*",
        "https://www.amazon.co.uk/shop/*",
        "https://www.amazon.co.uk/creatorhub/*",
        "https://affiliate-program.amazon.co.uk/p/connect/*",
        "https://www.amazon.co.uk/s*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/dp/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/gp/product/*",
        "https://www.amazon.ca/dp/*",
        "https://www.amazon.ca/*/dp/*",
        "https://www.amazon.ca/gp/product/*",
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.co.uk/*/dp/*",
        "https://www.amazon.co.uk/gp/product/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
