# Environment variables for influencerbutler.com
#
# This is a template. Copy it to .env.local for local development and fill in
# real values. The same keys must also be set in every deployed environment
# (production + any preview/staging) via the hosting dashboard, because
# .env.local is gitignored and never ships.
#
# When you add a new feature that reads a new process.env var, add it here in
# the same commit. A var that exists locally but was never added to production
# fails silently in the host and surfaces as a generic "temporarily
# unavailable" error to users (this is exactly how the Deals add-on
# checkout broke: LEMONSQUEEZY_VARIANT_DAILY_DEALS_ADDON was set locally but
# missing in prod).
#
# Naming: NEXT_PUBLIC_* values are exposed to the browser bundle. Everything
# else is server-only. Do not move a secret behind a NEXT_PUBLIC_ prefix.

# ----------------------------------------------------------------------------
# Supabase (auth + database)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS, used by webhooks, license lookup, and admin paths.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Lemon Squeezy (checkout, subscriptions, webhooks)
# ----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=your-ls-api-key
LEMONSQUEEZY_STORE_ID=000000
# Verifies inbound webhook signatures (src/lib/webhooks.ts).
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Per-plan LS variant IDs. resolveVariantId() in src/lib/lemonsqueezy.ts maps
# each plan string to one of these. A missing var returns "missing-env" and the
# matching checkout route returns 500/502, so the Buy button shows
# "Checkout is temporarily unavailable".
#
# Pro Solo (the bare "monthly"/"annual" plan strings alias to these):
LEMONSQUEEZY_VARIANT_MONTHLY=000000
LEMONSQUEEZY_VARIANT_ANNUAL=000000
# Pro Trio (3 devices; the env vars keep the original DUO spelling):
LEMONSQUEEZY_VARIANT_DUO_MONTHLY=000000
LEMONSQUEEZY_VARIANT_DUO_ANNUAL=000000
# Pro Team:
LEMONSQUEEZY_VARIANT_TEAM_MONTHLY=000000
LEMONSQUEEZY_VARIANT_TEAM_ANNUAL=000000
# Pro Agency:
LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=000000
LEMONSQUEEZY_VARIANT_AGENCY_ANNUAL=000000
# Daily Deals Workspace add-on ($24.99/mo, no promo/affiliate codes apply).
# Required by both checkout routes AND the webhook + welcome page that detect
# add-on orders. If unset, /daily-deals-workspace checkout fails.
LEMONSQUEEZY_VARIANT_DAILY_DEALS_ADDON=000000

# Public link to the LS affiliate program signup (rendered in the dashboard).
NEXT_PUBLIC_LEMONSQUEEZY_AFFILIATE_SIGNUP_URL=https://your-store.lemonsqueezy.com/affiliates

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
# Used for trial / conversion / affiliate-approval / webhook receipt emails.
RESEND_API_KEY=your-resend-api-key
# Where affiliate-application notifications are sent.
ADMIN_NOTIFICATION_EMAIL=admin@influencerbutler.com
# Optional. Signs the one-click unsubscribe links in marketing / funnel emails
# (src/lib/email-unsubscribe.ts). Any long random string. If unset it falls back
# to CRON_SECRET, then SUPABASE_SERVICE_ROLE_KEY, so unsubscribe still works
# without it; set a dedicated value if you ever rotate those without wanting to
# invalidate outstanding unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=your-unsubscribe-signing-secret
# Svix signing secret (whsec_...) for the Resend events webhook
# (/api/webhooks/resend), from Resend dashboard -> Webhooks after adding the
# endpoint. Fills in delivered/opened/clicked/bounced on email_sends rows for
# the admin Emails dashboard. The route rejects all requests until this is set.
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
# Base URL used to build LS redirect_url (the /welcome page) and email links.
# Either is accepted; falls back to https://www.influencerbutler.com if unset.
SITE_URL=https://www.influencerbutler.com
NEXT_PUBLIC_SITE_URL=https://www.influencerbutler.com

# ----------------------------------------------------------------------------
# Meta (Facebook) Pixel + Conversions API
# ----------------------------------------------------------------------------
# Seeds the custom audiences behind Facebook ad lookalikes. Setup walkthrough:
# docs/meta-ads-tracking.md. All Meta tracking (browser pixel + server events)
# no-ops while these are unset, so the site works fine without them.
#
# Pixel/dataset id from Meta Events Manager. Public by design: the browser
# pixel needs it, and src/lib/meta-capi.ts reuses it for the server endpoint
# so the two sides can never point at different datasets.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Server-only Conversions API token (Events Manager > Settings > Conversions
# API > Generate access token).
META_CAPI_ACCESS_TOKEN=your-meta-capi-token
# Optional. Routes server events into the Test Events tab in Events Manager
# while QA-ing. NEVER set in production: test-tagged events are excluded from
# real audiences.
# META_TEST_EVENT_CODE=TEST00000

# ----------------------------------------------------------------------------
# Access control + automation secrets
# ----------------------------------------------------------------------------
# Comma-separated list of emails granted admin access (src/lib/admin.ts).
ADMIN_EMAILS=you@example.com,teammate@example.com
# Shared secret guarding the affiliate-funnel cron route.
CRON_SECRET=your-cron-secret
# Shared secret for the /api/profiles/by-license feedback lookup.
FEEDBACK_LOOKUP_SECRET=your-feedback-lookup-secret
# Support dashboard -> feedback Worker /agent/* proxy (admin Support section).
# SUPPORT_BOT_TOKEN must match the same-named secret on the feedback Worker
# (workers/feedback). FEEDBACK_WORKER_URL is optional; it defaults to the
# production Worker. Server-side only: never exposed to the browser.
SUPPORT_BOT_TOKEN=your-support-bot-token
FEEDBACK_WORKER_URL=https://feedback.influencerbutler.com
# Call scheduling. Google Calendar OAuth (auto-creates a Google Meet link per
# booking on the owner's calendar). Create an OAuth 2.0 "Web application" client
# in Google Cloud, add the callback below as an authorized redirect URI, then
# click "Connect Google Calendar" in the Scheduling admin. If unset/unconnected,
# bookings fall back to call_config.default_join_url.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# The exact callback registered in Google Cloud (must match). Defaults to
# https://www.influencerbutler.com/api/admin/scheduling/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://www.influencerbutler.com/api/admin/scheduling/google/callback
# Where new-booking notifications go. Defaults to the first ADMIN_EMAILS entry.
SCHEDULING_OWNER_EMAIL=you@example.com
# Call recording + AI notes. A Recall.ai meeting bot records each Google Meet
# call (Google restricts native Meet recording to paid Workspace plans, and
# calls are hosted on a free Gmail account, so a joining bot is the only capture
# path). RECALL_API_KEY is required to schedule bots; RECALL_API_BASE is the
# region origin (defaults to https://us-west-2.recall.ai); RECALL_WEBHOOK_SECRET
# is the Svix signing secret used to verify the /api/booking/recall-webhook
# callback. Without RECALL_API_KEY, bookings still work but recording is skipped.
RECALL_API_KEY=your-recall-api-key
RECALL_API_BASE=https://us-west-2.recall.ai
RECALL_WEBHOOK_SECRET=your-recall-webhook-signing-secret
# LLM that turns the call transcript into review notes AND auto-extracts support
# tickets (issues/feature requests) from the call. GROQ_API_KEY is used first
# (cheapest, pennies per call); OPENAI_API_KEY (gpt-4o-mini) is the fallback.
# Without either key the transcript is still stored but no AI notes/tickets are made.
#   AI_NOTES_MODEL     overrides the notes model. NOTE: the built-in default
#                      (llama-3.3-70b-versatile) was decommissioned 2026-08-16, so
#                      set this to a current Groq model (e.g. openai/gpt-oss-120b).
#   CALL_TICKETS_MODEL overrides the ticket-extraction model (defaults to a current
#                      model already, so this is optional).
GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-api-key
# AI_NOTES_MODEL=openai/gpt-oss-120b
# CALL_TICKETS_MODEL=openai/gpt-oss-120b
# Butler AI concierge (instant AI demo/support call at /dashboard/ai-concierge).
# The VOICE path uses the OpenAI Realtime API, so OPENAI_API_KEY above is REQUIRED
# and must have Realtime access + budget (voice is metered, roughly $0.50-1 per
# 5-10 min session). The TEXT path reuses GROQ_API_KEY (near-free). Tunables:
# AI_CONCIERGE_REALTIME_MODEL=gpt-realtime
# AI_CONCIERGE_VOICE=marin
# AI_CONCIERGE_MAX_SESSION_SECS=600
# AI_CONCIERGE_DAILY_LIMIT=5
# Master secret for the Chrome extension OAuth2 Creator API credential vault
# (/api/extension/creator-api + /api/extension/enrich). Encrypts the OAuth
# Credential Secret at rest. Any long random string; it is hashed to a 32-byte
# AES-256-GCM key. Without it, saving credentials fails and the extension keeps
# showing the "set up Creator API" prompt. Set this in the Vercel dashboard,
# never in git. Rotating it invalidates all stored secrets (users must re-paste
# their credentials).
CREATOR_API_ENC_KEY=your-creator-api-encryption-secret
# Optional override for the licensing Worker base URL used by Creator API backup
# credential leasing (/license/creators-backup-credentials). Defaults to
# https://licensing.influencerbutler.com. Backup leasing also requires
# CREATORS_BACKUP_ENABLED=1 and the CREATORS_BACKUP_* secrets set ON THAT WORKER.
# BB_LICENSING_WORKER_URL=https://licensing.influencerbutler.com
# Token + repo (owner/name) for the admin catalogue-harvest GitHub dispatch.
GITHUB_DISPATCH_TOKEN=your-github-pat
GITHUB_DISPATCH_REPO=owner/repo
# Admin blog manager (/dashboard/admin/blog). Saves commit content/blog/* and
# public/assets/blog/* to THIS website repo via the GitHub API, which triggers
# a Vercel deploy. Distinct from GITHUB_DISPATCH_* above, which targets the
# desktop repo. Needs a fine-grained PAT with Contents: read & write on this
# repo. Branch defaults to main. AI hero generation reuses OPENAI_API_KEY.
GITHUB_CONTENT_TOKEN=your-github-pat
GITHUB_CONTENT_REPO=owner/influencerbutler.com
# GITHUB_CONTENT_BRANCH=main
# Blog content autopilot (/dashboard/admin/blog/autopilot + /api/cron/blog-autogen).
# The writer model is any OpenAI chat model id; heroes use gpt-image-1 via
# OPENAI_API_KEY. Set BLOG_AUTOGEN_DISABLED=1 to pause generation without a
# deploy (the cron exits immediately).
# BLOG_WRITER_MODEL=gpt-4o
# BLOG_AUTOGEN_DISABLED=1
# Token for the catalogue-harvest heartbeat endpoint.
HARVEST_HEARTBEAT_TOKEN=your-heartbeat-token
# R2 read access for the daily extension catalogue-filter build cron
# (/api/cron/build-catalogue-filters). Account id + a Cloudflare API token
# scoped to R2 object read on the influencerbutler bucket. Without these the
# cron no-ops and the extension shows no campaign badges.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_READ_TOKEN=your-r2-read-api-token

# Remote kill switch for the Chrome extension (/api/extension/flags). A JSON
# object the extension polls every ~30 min; lets you disable a misbehaving tool
# (or the whole extension) in the wild, and push corrected DOM selector lists,
# WITHOUT waiting for a Chrome Web Store review. Change it here (Vercel env) and
# redeploy to push. Unset or invalid JSON means "no flags" (everything on).
# disabledTools entries are the extension's tool keys (e.g. storefront,
# searchOverlay, ideaListOverlay); selectorOverrides keys are selector-registry
# ids. Example:
# EXTENSION_FLAGS={"disabledTools":["storefront"],"notice":"Storefront check paused while Amazon settles a change."}
EXTENSION_FLAGS=
